#!/bin/zsh
# pre-commit hook — ローカル限定: format, lint, test, CCN check
echo "=== 🧹 Ruff Format ==="
uv run ruff format --check .
if [ $? -ne 0 ]; then
    echo "❌ Format check failed. Commit aborted."
    exit 1
fi
echo "✅ Format passed"
echo

echo "=== 🧹 Ruff Lint ==="
uv run ruff check src/ tests/
if [ $? -ne 0 ]; then
    echo "❌ Lint failed. Commit aborted."
    exit 1
fi
echo "✅ Lint passed"
echo

echo "=== 🧪 Pytest ==="
uv run pytest
if [ $? -ne 0 ]; then
    echo "❌ Tests failed. Commit aborted."
    exit 1
fi
echo "✅ Tests passed"
echo

echo "=== 📊 CCN Check (lizard, threshold: 20) ==="
uv run lizard src/ --CCN 20 --warnings_only
if [ $? -ne 0 ]; then
    echo "❌ CCN threshold exceeded. Commit aborted."
    exit 1
fi
echo "✅ CCN check passed"
echo

echo "🎉 All checks passed. Committing..."
