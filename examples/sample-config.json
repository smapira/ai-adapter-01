{
  "version": 1,
  "default_env": "default",
  "agent_bindings": [
    { "agent": "reviewer", "env": "myhome" },
    { "agent": "implementer", "env": "office" }
  ],
  "agents": [
    { "name": "reviewer", "description": "Code review agent" },
    { "name": "implementer", "description": "Implementation agent" }
  ],
  "envs": [
    { "name": "default", "description": "Default environment" },
    { "name": "myhome", "description": "Home development environment" },
    { "name": "office", "description": "Office development environment" }
  ],
  "bins": [
    { "name": "deploy-prod.sh", "env": "myhome", "description": "Production deploy" },
    { "name": "deploy-staging.sh", "env": "myhome", "description": "Staging deploy" },
    { "name": "format-all.sh", "env": "default", "description": "Format code" }
  ],
  "skills": [
    {
      "name": "database-schema",
      "description": "Database schema design/review knowledge",
      "path": "skills/database-schema",
      "tags": ["database", "prisma", "schema"],
      "agent": "reviewer"
    },
    {
      "name": "security-review",
      "description": "Security review checklist",
      "path": "skills/security-review",
      "tags": ["security", "review"]
    }
  ],
  "mcp_servers": [
    {
      "name": "github",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github"],
      "env_keys": ["GITHUB_TOKEN"],
      "enabled": true,
      "tools": ["vscode", "claude", "cursor"],
      "env": "myhome"
    },
    {
      "name": "filesystem",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "."],
      "enabled": true,
      "tools": ["vscode", "cursor"]
    }
  ]
}
